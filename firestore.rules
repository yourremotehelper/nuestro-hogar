rules_version = '2';
// Reglas de seguridad de Firestore para "Nuestro Hogar".
// Pégalas en: Consola de Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Cada persona solo ve qué hogar tiene asignado
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      // Hace falta poder leerlo para unirse con el enlace de invitación
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        // Los miembros pueden editar el hogar
        request.auth.uid in resource.data.members
        // Alguien nuevo solo puede añadirse a sí mismo (y su nombre)
        || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
             && request.resource.data.members.hasAll(resource.data.members)
             && request.resource.data.members.size() == resource.data.members.size() + 1
             && request.auth.uid in request.resource.data.members
             && resource.data.members.size() < 6 )
      );
      allow delete: if false;

      // Todo el contenido (tareas, compra, gastos…) solo para miembros
      match /items/{itemId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
